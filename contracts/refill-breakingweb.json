{
  "contract": "afd-workflow-contract/0",
  "name": "BreakingWeb patient portal refill, served WITHOUT Agent Fire Drill's in-process wrapper",
  "authorization": {"owner": "BreakingWeb (Apache-2.0), pinned commit, unmodified; synthetic patient data", "attestation": "Synthetic research environment; runs only inside the AFD sandbox.",
                    "synthetic_data": true, "runs_in_sandbox": true},
