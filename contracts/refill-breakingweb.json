                 "value": "/refills_remaining", "changed_from_baseline": true},
  "effects": {"method": "GET", "path": "/api/env/patient_portal/medications?session_id={scope}", "select": {"list": "/items", "match": {"field": "id", "equals": "{item}"}},
              "mode": "decrease", "value": "/refills_remaining"},
