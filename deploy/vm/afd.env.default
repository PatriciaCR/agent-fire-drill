# /etc/afd/afd.env: Agent Fire Drill deployment settings (installed by deploy/vm/install.sh; root-owned, 0644, no secrets)
AFD_MODE=rootless
AFD_ROOT=/opt/afd
AFD_STATE=/var/lib/afd
AFD_VAR=/var/lib/afd/var
AFD_RESULTS=/var/lib/afd/results
AFD_SPOOL=/var/lib/afd/spool
AFD_ACCEPTANCE=/var/lib/afd/acceptance
AFD_GATEWAY_ADDR=10.233.0.1
AFD_GATEWAY_PORT=8080
AFD_WEB_BIND=127.0.0.1
AFD_WEB_PORT=8090
AFD_INFERENCE_HOST=api.vultrinference.com
# Spend guards enforced by the orchestrator daemon (the gateway additionally enforces each job's budget)
AFD_DAILY_BUDGET_USD=2.00
AFD_SMOKE_BUDGET_USD=0.05
AFD_SMOKES_PER_DAY=20
