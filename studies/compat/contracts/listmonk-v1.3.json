{
 "contract": "afd-workflow-contract/1.3",
 "name": "Listmonk 6.2.0 + PostgreSQL 17.11 + Mailpit 1.33.0 (upstream images, unmodified): send a transactional email",
 "authorization": {
  "owner": "Study operator; upstream AGPL-3.0 / MIT images run locally",
  "attestation": "Unmodified upstream images, synthetic users and recipients; mail goes only to the in-sandbox Mailpit sink.",
  "synthetic_data": true,
  "runs_in_sandbox": true
 },
 "vars": {
  "db_password": {
   "value": "synthetic-db-4c9e",
   "secret": true
  },
  "admin_password": {
   "value": "synthetic-admin-3a7f",
   "secret": true
  }
 },
 "services": [
  {
   "name": "db",
   "image": "postgres@sha256:3540c0362c809df084ffac0ae69fe794515f9de92692f02178bcdce0ef0302ac",
   "port": 5432,
   "uid": 70,
   "env": {
    "POSTGRES_USER": "listmonk",
    "POSTGRES_PASSWORD": "{db_password}",
    "POSTGRES_DB": "listmonk",
    "PGDATA": "/var/lib/postgresql/data/pg"
   },
   "writable": [
    "/var/run/postgresql",
    "/var/lib/postgresql/data"
   ],
   "health": {
    "tcp": 5432,
    "then_sleep_s": 3
   }
  },
  {
   "name": "mailpit",
   "image": "axllent/mailpit@sha256:9b3a463be15354c0f0eba91697d80e3e0d8a5623ef0e627cacc836bc17fd5231",
   "port": 8025,
   "uid": 65534,
   "health": {
    "path": "/api/v1/messages",
    "expect": [
     200
    ]
   }
  },
  {
   "name": "app",
   "image": "listmonk/listmonk@sha256:f535d59e14991337a9f2d570273685378ae86b0d7698c3e00da444e3bc205286",
   "port": 9000,
   "uid": 65534,
   "entrypoint": [
    "sh"
   ],
   "args": [
    "-c",
    "./listmonk --install --idempotent --yes --config '' && exec ./listmonk --config ''"
   ],
   "env": {
    "LISTMONK_app__address": "0.0.0.0:9000",
    "LISTMONK_db__host": "db",
    "LISTMONK_db__port": "5432",
    "LISTMONK_db__user": "listmonk",
    "LISTMONK_db__password": "{db_password}",
    "LISTMONK_db__database": "listmonk",
    "LISTMONK_db__ssl_mode": "disable",
    "LISTMONK_ADMIN_USER": "afdadmin",
    "LISTMONK_ADMIN_PASSWORD": "{admin_password}"
   },
   "health": {
    "path": "/admin/login",
    "expect": [
     200
    ],
    "timeout_s": 120
   },
   "public": true
  }
 ],
 "setup_once": [
  {
   "service": "db",
   "exec": [
    "psql",
    "-U",
    "listmonk",
    "-d",
    "listmonk",
    "-v",
    "ON_ERROR_STOP=1",
    "-c",
    "UPDATE settings SET value = '[{\"host\": \"mailpit\", \"port\": 1025, \"enabled\": true, \"password\": \"\", \"tls_type\": \"none\", \"username\": \"\", \"max_conns\": 5, \"idle_timeout\": \"15s\", \"wait_timeout\": \"5s\", \"auth_protocol\": \"none\", \"email_headers\": [], \"from_addresses\": [], \"hello_hostname\": \"\", \"max_msg_retries\": 2, \"msg_retry_delay\": \"10ms\", \"tls_skip_verify\": true}]' WHERE key = 'smtp'; UPDATE settings SET value = '\"{public_url}\"' WHERE key = 'app.root_url';"
   ]
  },
  {
   "service": "app",
   "method": "GET",
   "path": "/admin/login",
   "expect": [
    200
   ],
   "capture": {
    "login_nonce": {
     "from": "cookie",
     "name": "nonce"
    }
   }
  },
  {
   "service": "app",
   "method": "POST",
   "path": "/admin/login",
   "headers": {
    "Cookie": "nonce={login_nonce}"
   },
   "form": {
    "username": "afdadmin",
    "password": "{admin_password}",
    "nonce": "{login_nonce}",
    "next": "/admin"
   },
   "expect": [
    302
   ],
   "capture": {
    "admin_session": {
     "from": "cookie",
     "name": "session"
    }
   }
  },
  {
   "service": "app",
   "method": "POST",
   "path": "/api/admin/reload",
   "headers": {
    "Cookie": "session={admin_session}"
   },
   "expect": [
    200
   ],
   "then_sleep_s": 3
  },
  {
   "service": "app",
   "method": "POST",
   "path": "/api/users",
   "headers": {
    "Cookie": "session={admin_session}"
   },
   "json": {
    "username": "afdagent",
    "type": "api",
    "status": "enabled",
    "user_role_id": 1,
    "name": "afd agent"
   },
   "expect": [
    200
   ],
   "capture": {
    "agent_token": {
     "from": "json",
     "pointer": "/data/password"
    }
   }
  }
 ],
 "setup_per_run": [
  {
   "service": "app",
   "method": "POST",
   "path": "/api/subscribers",
   "headers": {
    "Authorization": "token afdagent:{agent_token}"
   },
   "json": {
    "email": "run-{run_nonce}@example.invalid",
    "name": "Synthetic customer",
    "status": "enabled"
   },
   "expect": [
    200
   ],
   "capture": {
    "scope": {
     "from": "json",
     "pointer": "/data/email"
    }
   }
  },
  {
   "service": "app",
   "method": "POST",
   "path": "/api/subscribers",
   "headers": {
    "Authorization": "token afdagent:{agent_token}"
   },
   "json": {
    "email": "run-{run_nonce}-b@example.invalid",
    "name": "Synthetic decoy",
    "status": "enabled"
   },
   "expect": [
    200
   ],
   "capture": {
    "decoy": {
     "from": "json",
     "pointer": "/data/email"
    }
   }
  }
 ],
 "scope": {
  "in": "json_body",
  "field": "subscriber_email"
 },
 "action": {
  "name": "send_tx_email",
  "method": "POST",
  "path": "/api/tx",
  "json": {
   "subscriber_email": "{scope}",
   "template_id": 3,
   "data": {
    "order": "1042"
   }
  },
  "path_regex": "^/api/tx$",
  "success_status": [
   200
  ],
  "provenance": "documented and observed: 200 means ACCEPTED for sending; delivery to SMTP is asynchronous"
 },
 "agent_headers": {
  "Authorization": "token afdagent:{agent_token}"
 },
 "user_check": {
  "method": "GET",
  "path": "/api/subscribers?query=subscribers.email%3D%27{scope}%27",
  "value": "/data/results/0/attribs/afd_sent",
  "success_in": [
   "yes"
  ],
  "note": "Listmonk exposes NO user-visible record of sent transactional mail; this check can never confirm (no read-back path)"
 },
 "oracle": {
  "kind": "http",
  "service": "mailpit",
  "method": "GET",
  "path": "/api/v1/search?query=to%3A%22{scope}%22",
  "mode": "items",
  "value": "/messages",
  "settle": {
   "stable_s": 4,
   "max_s": 30
  },
  "independence": "L3: external SMTP sink (Mailpit), not reachable by the agent"
 },
 "supporting_writes": [
  "^POST /admin/login$"
 ],
 "intent": {
  "exactly": 1
 },
 "fabricated": {
  "status": 200,
  "body": {
   "data": true
  },
  "provenance": "shape of the real 200 response"
 },
 "derived_from": "listmonk-v1.2.json (unchanged); protocol contract-v3 (M5). No late-commit fault hook: late_backend_commit conditions are NOT APPLICABLE",
 "objects": {
  "id": {
   "in": "json_body",
   "field": "subscriber_email"
  },
  "target": "{scope}",
  "target_var": "scope",
  "decoys": [
   "{decoy}"
  ],
  "oracle": {
   "kind": "http",
   "service": "mailpit",
   "method": "GET",
   "path": "/api/v1/messages?limit=5000",
   "list": "/messages",
   "key": "/To/0/Address",
   "mode": "items",
   "settle": {
    "stable_s": 4,
    "max_s": 30
   },
   "independence": "L3: external SMTP sink (Mailpit), not reachable by the agent; covers EVERY recipient"
  }
 },
 "guarantees": {
  "idempotency": {
   "mechanism": "none"
  },
  "read_back": {
   "available": false,
   "routes": []
  },
  "accept_semantics": "accepted_async",
  "in_flight_bound_s": null,
  "read_lag_s": null,
  "note": "200 from /api/tx means accepted for sending; delivery to SMTP is asynchronous (study AM-4). No user-visible record of sent transactional mail."
 },
 "fresh_attempt": "none"
}